#!/usr/bin/env grease
# Original fixtures and Python-2 reference are test-only boundaries.
set -eu -o pipefail
if (len(ARGV) !== 0) { echo 'qualify-shift.grease takes no arguments' >&2; exit 2 }
var directory = $(dirname "$0")
var root = $(realpath "$directory/../../..")
cd "$root"
var output = "$root/ysh/d/.build/inherited-spec"
test -x "$output/native-osh"
test -x "$root/bin/osh"

proc compare (fixture, range, name, records, matches) {
  env "PYTHONPATH=$root:$root/vendor" python2.7 "$root/test/sh_spec.py" -v --details --range "$range" --timeout=3 \
    --tmp-env "$output/tmp/$name" \
    --path-env "$root/spec/bin:$[ENV.PATH]" \
    --env-pair LC_ALL=C.UTF-8 --env-pair "REPO_ROOT=$root" \
    --tsv-output "$output/$name.tsv" \
    "$root/$fixture" "$output/native-osh" "$root/bin/osh"
  var actualRecords = $(wc -l < "$output/$name.tsv")
  test "$actualRecords" -eq "$records"
  var actualMatches = $(grep -Ec '	(native-osh|osh)	pass$' "$output/$name.tsv")
  test "$actualMatches" -eq "$matches"
}

compare spec/builtin-misc.test.sh 4-6 shared-shift 7 6
compare spec/arg-parse.test.sh 1 shared-shift-extra 3 2
"$root/ysh/d/.build/ysh-d" "$root/ysh/d/qualification/shift-wide.grease" > "$output/shift-wide.native.stdout" 2> "$output/shift-wide.native.stderr"
"$root/bin/ysh" "$root/ysh/d/qualification/shift-wide.grease" > "$output/shift-wide.reference.stdout" 2> "$output/shift-wide.reference.stderr"
cmp "$root/ysh/d/qualification/shift-wide.stdout" "$output/shift-wide.native.stdout"
cmp "$root/ysh/d/qualification/shift-wide.stdout" "$output/shift-wide.reference.stdout"
test ! -s "$output/shift-wide.native.stderr"
test ! -s "$output/shift-wide.reference.stderr"
printf 'case\tshell\tstatus\tresult\nwide-index\tnative\t0\tpass\nwide-index\treference\t0\tpass\n' > "$output/shared-shift-wide.tsv"
echo 'PASS four unchanged shift cases and one wide-index probe in native D and actual Oils'
