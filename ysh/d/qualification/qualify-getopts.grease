#!/usr/bin/env grease
# The original spec harness and Python2 reference are test-only boundaries.
# Additional inputs use that harness's existing OSH/YSH compatibility format.
set -eu -o pipefail
if (len(ARGV) !== 0) { echo 'qualify-getopts.grease takes no arguments' >&2; exit 2 }
var directory = $(dirname "$0")
var root = $(realpath "$directory/../../..")
cd "$root"
var output = "$root/ysh/d/.build/inherited-spec"
test -x "$output/native-osh"
test -x "$root/bin/osh"

proc compare (fixture, range, name, records, matches) {
  env "PYTHONPATH=$root:$root/vendor" python2.7 "$root/test/sh_spec.py" -v --details --range "$range" --timeout=3 \
    --tmp-env "$output/tmp/$name" \
    --path-env "$root/spec/bin:$[ENV.PATH]" \
    --env-pair LC_ALL=C.UTF-8 --env-pair "REPO_ROOT=$root" \
    --tsv-output "$output/$name.tsv" \
    "$root/$fixture" "$output/native-osh" "$root/bin/osh"
  var actualRecords = $(wc -l < "$output/$name.tsv")
  test "$actualRecords" -eq "$records"
  var actualMatches = $(grep -Ec '	(native-osh|osh)	pass$' "$output/$name.tsv")
  test "$actualMatches" -eq "$matches"
}

# The retained reference fails original reset expectations13-15. Keep those
# failures visible in the full31-case receipt without a new native allowance.
compare spec/builtin-getopts.test.sh 0-12 shared-getopts-basic 27 26
compare spec/builtin-getopts.test.sh 16-30 shared-getopts-rest 31 30
compare ysh/d/qualification/getopts/contract.test.sh 0-27 getopts-contract 57 56
compare ysh/d/qualification/getopts/typed-order.test.sh 0-5 getopts-typed-order 13 12
compare ysh/d/qualification/getopts/stage-order.test.sh 0-5 getopts-stage-order 13 12
compare ysh/d/qualification/getopts/child-failure.test.sh 0-3 getopts-child-failure 9 8
compare ysh/d/qualification/getopts/invocation-generic.test.sh 0-8 invocation-generic 19 18
compare ysh/d/qualification/getopts/temp-bindings.test.sh 0-4 getopts-temp-bindings 11 10
compare ysh/d/qualification/getopts/prefix-order.test.sh 0-0 invocation-prefix-order 3 2
echo 'PASS 28 unchanged getopts cases and 59 additional paired contracts in native D and actual Oils'
